<Window x:Class="WinTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTime.ViewModels"
        xmlns:views="clr-namespace:WinTime.Views"
        Title="WinTime"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#16161E"
        Foreground="White"
        Closing="Window_Closing">

    <!-- DataTemplate: ViewModel → View (ContentControl навигация) -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
            <views:ApplicationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Стиль навигационных кнопок сайдбара -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"             Value="Transparent" />
            <Setter Property="Foreground"             Value="#9CA3AF" />
            <Setter Property="BorderThickness"        Value="0" />
            <Setter Property="Padding"                Value="16 11" />
            <Setter Property="FontSize"               Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor"                 Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#252535" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════ САЙДБАР ══════════════════ -->
        <Border Grid.Column="0" Background="#1C1C28">
            <DockPanel>

                <!-- Логотип -->
                <Border DockPanel.Dock="Top" Padding="20 24 20 20">
                    <StackPanel>
                        <TextBlock Text="⏱  WinTime"
                                   FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Учёт экранного времени"
                                   FontSize="11" Foreground="#6B7280" Margin="0 3 0 0" />
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Border DockPanel.Dock="Top" Height="1" Background="#252535" Margin="16 0" />

                <!-- Кнопка паузы внизу -->
                <Border DockPanel.Dock="Bottom" Padding="12 16">
                    <Button Style="{StaticResource NavBtn}"
                            Content="{Binding TrackingLabel}"
                            Command="{Binding ToggleTrackingCommand}"
                            Foreground="#F59E0B"
                            HorizontalAlignment="Stretch" />
                </Border>

                <!-- Разделитель низа -->
                <Border DockPanel.Dock="Bottom" Height="1" Background="#252535" Margin="16 0" />

                <!-- Навигационные кнопки -->
                <StackPanel DockPanel.Dock="Top" Margin="10 16">
                    <Button Content="📊   Дашборд"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateDashboardCommand}"
                            Margin="0 2" />
                    <Button Content="🗂   Приложения"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateApplicationsCommand}"
                            Margin="0 2" />
                    <Button Content="⚙   Настройки"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateSettingsCommand}"
                            Margin="0 2" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════ КОНТЕНТ ══════════════════ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Focusable="False" />

    </Grid>
</Window>
