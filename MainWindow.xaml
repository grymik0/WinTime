<Window x:Class="WinTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTime.ViewModels"
        xmlns:views="clr-namespace:WinTime.Views"
        Title="WinTime"
        Icon="Assets/icon.ico"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="Window_Closing">

    <!-- DataTemplate: ViewModel → View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
            <views:ProcessesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
            <views:ApplicationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GoalsViewModel}">
            <views:GoalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopWidgetViewModel}">
            <views:DesktopWidgetSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThemeCustomizationViewModel}">
            <views:ThemeCustomizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"             Value="Transparent" />
            <Setter Property="Foreground"             Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness"        Value="0" />
            <Setter Property="Padding"                Value="16 11" />
            <Setter Property="FontSize"               Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor"                 Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <DockPanel>

                <Border DockPanel.Dock="Top" Padding="20 24 20 20">
                    <StackPanel>
                        <TextBlock Text="⏱  WinTime"
                                   FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource App_Subtitle}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 3 0 0" />
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrushColor}" Margin="16 0" />

                <!-- Кнопка паузы внизу -->
                <Border DockPanel.Dock="Bottom" Padding="12 16">
                    <Button Style="{StaticResource NavBtn}"
                            Content="{Binding TrackingLabel}"
                            Command="{Binding ToggleTrackingCommand}"
                            Foreground="#F59E0B"
                            HorizontalAlignment="Stretch" />
                </Border>

                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource BorderBrushColor}" Margin="16 0" />

                <StackPanel DockPanel.Dock="Top" Margin="10 16">
                    <Button Content="{DynamicResource Nav_Dashboard}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateDashboardCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Processes}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateProcessesCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Applications}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateApplicationsCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Goals}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateGoalsCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Profile}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateProfileCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Widget}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateWidgetCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Theme}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateThemeCommand}"
                            Margin="0 2" />
                    <Button Content="{DynamicResource Nav_Settings}"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateSettingsCommand}"
                            Margin="0 2" />
                </StackPanel>

            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        x:Name="ContentArea"
                        Content="{Binding CurrentView}"
                        Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
        </ContentControl>

    </Grid>
</Window>

