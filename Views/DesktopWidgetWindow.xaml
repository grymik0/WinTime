<Window x:Class="WinTime.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTime Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WidgetControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33334D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444466" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main widget container -->
    <Border Width="{Binding WidgetContainerWidth}"
            Background="#EE181825"
            BorderBrush="#3B3B52"
            BorderThickness="1"
            Margin="6">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14 12" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMicroMode}" Value="True">
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="Padding" Value="10 6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45" />
        </Border.Effect>

        <StackPanel>
            <!-- 1. Micro Mode (Floating pill) -->
            <Grid Visibility="{Binding IsMicroMode, Converter={StaticResource BoolToVis}}"
                  ToolTip="{DynamicResource Widget_MicroHint}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Streak badge if present -->
                    <Border Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                            Background="#331E12" CornerRadius="6" Padding="5 2" Margin="0 0 6 0"
                            ToolTip="{Binding StreakTooltip}">
                        <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                    </Border>

                    <!-- When no limit active: show today's PC time -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding DoesNotHaveAppLimit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏱" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0" />
                        <TextBlock Text="{Binding TodayTimeText}" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- When app limit is active: show remaining limit timer -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding LimitStatusText}">
                        <TextBlock Text="⏳" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0" />
                        <TextBlock Text="{Binding LimitRemainingText}" FontSize="12" FontWeight="Bold"
                                   Foreground="{Binding LimitBadgeColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Small cycle / expand icon button -->
                    <Button Style="{StaticResource WidgetControlBtn}"
                            Width="16" Height="16"
                            Margin="4 0 0 0"
                            Command="{Binding CycleModeCommand}"
                            ToolTip="{DynamicResource Widget_TipStandard}">
                        <Path Data="M 2.5,6.5 L 2.5,9.5 L 5.5,9.5 M 9.5,5.5 L 9.5,2.5 L 6.5,2.5 M 2.5,9.5 L 9.5,2.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Compact Mode strip -->
            <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                <TextBlock Grid.Column="1" Text="{Binding TodayTimeText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />

                <!-- Streak badge in compact mode -->
                <Border Grid.Column="2" Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                        Background="#331E12" CornerRadius="6" Padding="6 2" Margin="3 0"
                        ToolTip="{Binding StreakTooltip}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                </Border>

                <!-- Active app limit chip in compact mode -->
                <Border Grid.Column="3" Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}"
                        Background="#252535" CornerRadius="6" Padding="6 2" Margin="2 0 4 0"
                        ToolTip="{Binding LimitStatusText}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LimitRemainingText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding LimitBadgeColor}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Control buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Collapse to micro button -->
                    <Button Style="{StaticResource WidgetControlBtn}"
                            Command="{Binding CycleModeCommand}"
                            Margin="0 0 2 0"
                            ToolTip="{DynamicResource Widget_TipMicro}">
                        <Path Data="M 3,6 H 11"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <!-- Close button -->
                    <Button Style="{StaticResource WidgetControlBtn}"
                            Click="CloseButton_Click"
                            ToolTip="{DynamicResource Widget_TipHide}">
                        <Path Data="M 3.5,3.5 L 10.5,10.5 M 10.5,3.5 L 3.5,10.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. Standard Expanded Mode -->
            <StackPanel Visibility="{Binding IsStandardMode, Converter={StaticResource BoolToVis}}">
                <!-- Header: title, streak badge, collapse and close -->
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <TextBlock Text="WinTime" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />

                        <!-- Streak badge in standard mode -->
                        <Border Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                                Background="#331E12" CornerRadius="6" Padding="6 2" Margin="6 0 0 0"
                                ToolTip="{Binding StreakTooltip}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Collapse to Compact mode -->
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetControlBtn}"
                            Command="{Binding CycleModeCommand}"
                            Margin="0 0 4 0"
                            ToolTip="{DynamicResource Widget_TipCollapse}">
                        <Path Data="M 3,6 H 11"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <!-- Hide widget -->
                    <Button Grid.Column="2"
                            Style="{StaticResource WidgetControlBtn}"
                            Click="CloseButton_Click"
                            ToolTip="{DynamicResource Widget_TipHide}">
                        <Path Data="M 3.5,3.5 L 10.5,10.5 M 10.5,3.5 L 3.5,10.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <!-- Block 1: Active application + limit if applicable -->
                <StackPanel Visibility="{Binding ShowApp, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_InFocus}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding CurrentAppName}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0 1 0 0" />

                    <!-- Active limit badge -->
                    <Border Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}"
                            Background="#252535" CornerRadius="6" Padding="8 5" Margin="0 4 0 0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="⏳ Limit" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LimitStatusText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding LimitBadgeColor}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Height="3" Value="{Binding LimitProgress, Mode=OneWay}" Maximum="100"
                                         Background="#181825" Foreground="{Binding LimitBadgeColor}" BorderThickness="0" Margin="0 4 0 0">
                                <ProgressBar.Clip>
                                    <RectangleGeometry Rect="0,0,1000,3" RadiusX="1.5" RadiusY="1.5" />
                                </ProgressBar.Clip>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Block 2: Screen time today -->
                <StackPanel Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_TodayPc}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding TodayTimeText}"
                               FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0 1 0 0" />
                </StackPanel>

                <!-- Block 3: Continuous session timer -->
                <StackPanel Visibility="{Binding ShowSession, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_CurSession}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding SessionTimeText}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0 1 0 0" />
                </StackPanel>

                <!-- Block 4: Level & XP progress -->
                <StackPanel Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <Grid Margin="0 0 0 2">
                        <TextBlock Text="{Binding UserLevelText}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="{Binding XpProgressText}" FontSize="9" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Height="4" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100"
                                 Background="#252535" Foreground="#F59E0B" BorderThickness="0">
                        <ProgressBar.Clip>
                            <RectangleGeometry Rect="0,0,1000,4" RadiusX="2" RadiusY="2" />
                        </ProgressBar.Clip>
                    </ProgressBar>
                </StackPanel>

                <!-- Block 5: Mouse stats -->
                <StackPanel Visibility="{Binding ShowMouse, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Dash_MouseActivity}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding MouseSummaryText}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0 1 0 0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

