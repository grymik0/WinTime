<Window x:Class="WinTime.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTime Widget"
        Width="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Главная плашка виджета -->
    <Border Background="#EE181825"
            BorderBrush="#3B3B52"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14 12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45" />
        </Border.Effect>

        <StackPanel>
            <!-- 1. Компактный вид (если включен IsCompactMode) -->
            <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                <TextBlock Grid.Column="1" Text="{Binding TodayTimeText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />

                <!-- Кнопка развернуть -->
                <Button Grid.Column="2"
                        Content="▾"
                        Command="{Binding ToggleCompactCommand}"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Padding="4 0"
                        Margin="4 0"
                        ToolTip="{DynamicResource Widget_TipExpand}" />

                <!-- Кнопка закрыть -->
                <Button Grid.Column="3"
                        Content="✕"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="#6B7280"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        Padding="4 2"
                        ToolTip="{DynamicResource Widget_TipHide}" />
            </Grid>

            <!-- 2. Развёрнутый стандартный вид (если IsCompactMode == false) -->
            <StackPanel Visibility="{Binding IsNotCompactMode, Converter={StaticResource BoolToVis}}">
                <!-- Шапка: заголовок, кнопка свернуть в капсулу и кнопка закрытия -->
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <TextBlock Text="WinTime" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Кнопка компактного режима -->
                    <Button Grid.Column="1"
                            Content="▴"
                            Command="{Binding ToggleCompactCommand}"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand"
                            Padding="4 0"
                            Margin="0 0 4 0"
                            ToolTip="{DynamicResource Widget_TipCollapse}" />

                    <!-- Кнопка скрыть виджет -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            Padding="4 2"
                            ToolTip="{DynamicResource Widget_TipHide}" />
                </Grid>

                <!-- Блок 1: Текущее приложение -->
                <StackPanel Visibility="{Binding ShowApp, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_InFocus}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding CurrentAppName}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0 1 0 0" />
                </StackPanel>

                <!-- Блок 2: Время за сегодня -->
                <StackPanel Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_TodayPc}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding TodayTimeText}"
                               FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0 1 0 0" />
                </StackPanel>

                <!-- Блок 3: Непрерывная текущая сессия (сбрасывается при AFK) -->
                <StackPanel Visibility="{Binding ShowSession, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <TextBlock Text="{DynamicResource Widget_CurSession}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding SessionTimeText}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0 1 0 0" />
                </StackPanel>

                <!-- Блок 4: Уровень и XP -->
                <StackPanel Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                    <Grid Margin="0 0 0 2">
                        <TextBlock Text="{Binding UserLevelText}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="{Binding XpProgressText}" FontSize="9" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Height="4" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100"
                                 Background="#252535" Foreground="#F59E0B" BorderThickness="0">
                        <ProgressBar.Clip>
                            <RectangleGeometry Rect="0,0,1000,4" RadiusX="2" RadiusY="2" />
                        </ProgressBar.Clip>
                    </ProgressBar>
                </StackPanel>

                <!-- Блок 5: Мышь (клики и км) -->
                <StackPanel Visibility="{Binding ShowMouse, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Dash_MouseActivity}" FontSize="9" Foreground="#6B7280" />
                    <TextBlock Text="{Binding MouseSummaryText}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0 1 0 0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

