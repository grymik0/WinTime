<Window x:Class="WinTime.Views.WeeklyRecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weekly Recap"
        Width="700" Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RecapCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="16 14" />
            <Setter Property="Margin"          Value="0 0 0 12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"          Value="0 0 0 10" />
        </Style>

        <Style x:Key="ToggleWeekBtn" TargetType="Button">
            <Setter Property="Background"         Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"         Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness"    Value="0" />
            <Setter Property="Padding"            Value="12 5" />
            <Setter Property="FontSize"           Value="12" />
            <Setter Property="Cursor"             Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер окна -->
    <Border Background="{DynamicResource AppBgBrush}"
            BorderBrush="{DynamicResource BorderBrushColor}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24 18"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка окна -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Recap_Title}"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PeriodFormatted}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
                </StackPanel>

                <!-- Переключатель: Текущая / Прошлая неделя -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 16 0">
                    <Button Content="{DynamicResource Recap_CurrentWeekTab}"
                            Command="{Binding SelectCurrentWeekCommand}"
                            Margin="0 0 6 0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleWeekBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentWeek}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{DynamicResource Recap_PreviousWeekTab}"
                            Command="{Binding SelectPreviousWeekCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleWeekBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviousWeek}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Кнопка закрыть ✕ -->
                <Button Grid.Column="2"
                        Content="✕"
                        Click="CloseButton_Click"
                        Width="32" Height="32"
                        Background="{DynamicResource ControlBgBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Содержимое дайджеста -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0 0 -8 0" Padding="0 0 8 0">
                <StackPanel>

                    <!-- 1. Архетип / Звание недели -->
                    <Border Style="{StaticResource RecapCard}" Background="{DynamicResource CardSubBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PersonaBadge}"
                                           FontSize="28"
                                           FontFamily="Segoe UI Emoji"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                <TextBlock Text="{DynamicResource Recap_PersonaSection}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PersonaTitle}"
                                           FontSize="18" FontWeight="Bold" Foreground="{Binding PersonaColor}" Margin="0 2 0 4" />
                                <TextBlock Text="{Binding PersonaDesc}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Экранное время недели -->
                    <Border Style="{StaticResource RecapCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Recap_ScreenTime}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalActiveFormatted}"
                                           FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 4 0 2" />
                                <TextBlock Text="{Binding DailyAvgFormatted}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Значок тренда к прошлой неделе -->
                            <Border Grid.Column="1" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    CornerRadius="10" Padding="12 8">
                                <TextBlock Text="{Binding TrendFormatted}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 3. Динамика: Прорыв недели & Спад -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Прорыв недели -->
                        <Border Grid.Column="0" Style="{StaticResource RecapCard}" Margin="0" Background="{DynamicResource CardSubBgBrush}">
                            <StackPanel>
                                <TextBlock Text="🚀  Прорыв недели" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                <TextBlock Text="{Binding BreakthroughApp}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 4 0 2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BreakthroughDiff}" FontSize="11" Foreground="#10B981" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Спад недели -->
                        <Border Grid.Column="2" Style="{StaticResource RecapCard}" Margin="0" Background="{DynamicResource CardSubBgBrush}">
                            <StackPanel>
                                <TextBlock Text="📉  Главный спад" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                <TextBlock Text="{Binding CooldownApp}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 4 0 2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CooldownDiff}" FontSize="11" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4. Топ приложений недели -->
                    <Border Style="{StaticResource RecapCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Recap_TopApps}" Style="{StaticResource CardTitle}" />

                            <ItemsControl ItemsSource="{Binding TopApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 5 0 7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding RankBadge}" FontSize="18"
                                                       FontFamily="Segoe UI Emoji"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="8 0 16 0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="5" Value="{Binding Percentage}" Maximum="100" Margin="0 6 0 0"
                                                             BorderThickness="0" Background="{DynamicResource ControlBgBrush}"
                                                             Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FormattedTime}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Percentage, StringFormat={}{0:F0}%}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 5. Будни vs Выходные & Пиковый интервал суток -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Будни vs Выходные -->
                        <Border Grid.Column="0" Style="{StaticResource RecapCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Recap_WorkVsWeekend}" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0 2 0 6">
                                    <TextBlock Text="{DynamicResource Recap_Workdays}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WorkdaysFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0 0 0 8">
                                    <TextBlock Text="{DynamicResource Recap_Weekends}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WeekendsFormatted}" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding WorkVsWeekendVerdict}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Пиковое время суток -->
                        <Border Grid.Column="2" Style="{StaticResource RecapCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Recap_GoldenHour}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding PeakTimeSlotTitle}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 2 0 4" />
                                <TextBlock Text="{Binding PeakTimeSlotFormatted}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Время наивысшей продуктивности" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 6 0 0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 6. Сон и Самый активный день -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Сон и ритм -->
                        <Border Grid.Column="0" Style="{StaticResource RecapCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Recap_RhythmTitle}" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0 0 0 6">
                                    <TextBlock Text="{DynamicResource Recap_AvgBedtime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding AvgBedtime}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0 0 0 6">
                                    <TextBlock Text="{DynamicResource Recap_AvgWakeup}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding AvgWakeup}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Recap_AvgRest}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding AvgRestDuration}" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Самый активный день -->
                        <Border Grid.Column="2" Style="{StaticResource RecapCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Recap_PeakDay}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding PeakDayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0 2 0 4" />
                                <TextBlock Text="{Binding PeakDayTimeFormatted}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 7. Активность мыши и забавный факт -->
                    <Border Style="{StaticResource RecapCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Recap_MouseTitle}" Style="{StaticResource CardTitle}" />

                            <Grid Margin="0 0 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TotalClicksFormatted}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Recap_Clicks}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding TotalDistanceFormatted}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Recap_Distance}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="12 8">
                                <TextBlock Text="{Binding FunFactText}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Нижняя панель действий -->
            <Grid Grid.Row="3" Margin="0 12 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Кнопка копирования карточки -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Recap_BtnCopy}"
                            Command="{Binding CopyDigestCommand}"
                            Background="{DynamicResource ControlBgBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Padding="14 8"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding CopyFeedbackText}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#10B981"
                               VerticalAlignment="Center" Margin="10 0 0 0" />
                </StackPanel>

                <!-- Кнопка "Отлично" (закрыть) -->
                <Button Grid.Column="2"
                        Content="{DynamicResource Recap_BtnClose}"
                        Click="CloseButton_Click"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Padding="28 8"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>

