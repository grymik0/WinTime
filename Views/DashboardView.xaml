<UserControl x:Class="WinTime.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:WinTime.ViewModels"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Background"         Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"         Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness"    Value="0" />
            <Setter Property="Padding"            Value="18 7" />
            <Setter Property="FontSize"           Value="13" />
            <Setter Property="Cursor"             Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding"      Value="14 14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24 20 24 24">
        <StackPanel>

            <Grid Margin="0 0 0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Dash_Title}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="{DynamicResource Common_Loading}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 20">

                <Button Content="{DynamicResource Common_Today}" Margin="0 0 8 0"
                        Command="{Binding SetPeriodCommand}"
                        CommandParameter="{x:Static vm:TimePeriod.Today}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodToday}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{DynamicResource Common_Week}" Margin="0 0 8 0"
                        Command="{Binding SetPeriodCommand}"
                        CommandParameter="{x:Static vm:TimePeriod.Week}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodWeek}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{DynamicResource Common_Month}"
                        Command="{Binding SetPeriodCommand}"
                        CommandParameter="{x:Static vm:TimePeriod.Month}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodMonth}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <UniformGrid Columns="4" Margin="0 0 0 20">

                <Border Style="{StaticResource StatCard}" Margin="0 0 8 0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_ScreenTime}"
                                   FontSize="12" Foreground="#6B7280" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding TotalTime}"
                                   FontSize="26" FontWeight="Bold" Foreground="White" />

                        <Grid Margin="0 6 0 0"
                              Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ControlBgBrush}" CornerRadius="4" Padding="6 2" Margin="0 0 6 0">
                                <TextBlock Text="{Binding TrendPercentageText}"
                                           FontSize="11" FontWeight="Bold" Foreground="{Binding TrendColorHex}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding TrendDiffText}"
                                       FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TrendDiffText}" />
                        </Grid>

                        <TextBlock Text="{Binding TrendPeriodLabel}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 3 0 0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="4 0 4 0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_AfkTime}"
                                   FontSize="12" Foreground="#6B7280" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding IdleTime}"
                                   FontSize="26" FontWeight="Bold" Foreground="#F59E0B" />

                        <TextBlock Text="{Binding IdleRatioText}"
                                   FontSize="11" Foreground="#9CA3AF" Margin="0 8 0 0"
                                   Visibility="{Binding HasIdleRatio, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="4 0 4 0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_TopApp}"
                                   FontSize="12" Foreground="#6B7280" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding TopApp}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding SubMetricText}"
                                   FontSize="11" Foreground="#9CA3AF" Margin="0 14 0 0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSubMetric, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="8 0 0 0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_MouseActivity}"
                                   FontSize="12" Foreground="#6B7280" Margin="0 0 0 8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Клики -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding MouseClicksText}"
                                           FontSize="20" FontWeight="Bold" Foreground="#10B981"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{DynamicResource Dash_Clicks}" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0" />
                            </StackPanel>

                            <!-- Тонкий вертикальный разделитель -->
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushColor}" Margin="4 2 8 2" />

                            <!-- Дистанция -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding MouseDistanceText}"
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{DynamicResource Dash_Distance}" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Grid Height="300" Margin="0 0 0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="8">
                    <lvc:PieChart Series="{Binding PieSeries}"
                                  InitialRotation="-90"
                                  IsClockwise="True"
                                  LegendPosition="Bottom"
                                  LegendTextPaint="{Binding LegendTextPaint}"
                                  Background="Transparent" />
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10"
                        Padding="12 8" Margin="12 0 0 0">
                    <lvc:CartesianChart Series="{Binding BarSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        Background="Transparent"
                                        ZoomMode="None" />
                </Border>
            </Grid>

            <!-- Календарь активности (Heatmap) -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="20 16" Margin="0 0 0 20">
                <StackPanel>
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dash_HeatmapTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Dash_HeatmapSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="6 2 0 0" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource ControlBgBrush}" CornerRadius="6" Padding="10 4">
                            <TextBlock Text="{Binding HeatmapStatsText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0 4 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: Календарная сетка и легенда -->
                        <StackPanel Grid.Column="0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                    <!-- Подписи дней недели -->
                                    <StackPanel Margin="0 18 8 0">
                                        <TextBlock Text="1" FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text=""  FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="3" FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text=""  FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="5" FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text=""  FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="7" FontSize="9" Foreground="#6B7280" Height="16" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Недели -->
                                    <ItemsControl ItemsSource="{Binding HeatmapWeeks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="1.5 0">
                                                    <!-- Подпись месяца -->
                                                    <TextBlock Text="{Binding MonthLabel}"
                                                               FontSize="10" Foreground="#9CA3AF"
                                                               Height="18"
                                                               TextTrimming="None" />

                                                    <!-- Дни недели (7 квадратов) -->
                                                    <ItemsControl ItemsSource="{Binding Days}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="12" Height="12" Margin="0 2"
                                                                        CornerRadius="2.5"
                                                                        Background="{Binding FillBrush}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        BorderThickness="{Binding BorderThickness}"
                                                                        ToolTip="{Binding TooltipText}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Легенда -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24 4 0 0">
                                <TextBlock Text="{DynamicResource Dash_HeatmapLess}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0 0 6 0" />
                                <Border Width="11" Height="11" CornerRadius="2" Background="#252535" Margin="2 0" ToolTip="0 ч" />
                                <Border Width="11" Height="11" CornerRadius="2" Background="#3730A3" Margin="2 0" ToolTip="до 1 ч" />
                                <Border Width="11" Height="11" CornerRadius="2" Background="#4F46E5" Margin="2 0" ToolTip="1–3 ч" />
                                <Border Width="11" Height="11" CornerRadius="2" Background="#6366F1" Margin="2 0" ToolTip="3–6 ч" />
                                <Border Width="11" Height="11" CornerRadius="2" Background="#818CF8" Margin="2 0" ToolTip="6+ ч" />
                                <TextBlock Text="{DynamicResource Dash_HeatmapMore}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="6 0 0 0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushColor}" HorizontalAlignment="Center" Margin="0 4" />

                        <!-- Правая колонка: Анализ привычек и постоянства -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6 0 0 0">
                            <TextBlock Text="{DynamicResource Dash_ConsistencyTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0 0 12 0" />

                            <Grid Margin="0 10 0 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Метрика 1: Всего за 20 недель -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="12 8" Margin="0 0 6 6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dash_Total20Weeks}" FontSize="10" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding HeatmapTotalTimeText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 2 0 0" />
                                    </StackPanel>
                                </Border>

                                <!-- Метрика 2: Регулярность -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="12 8" Margin="6 0 0 6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dash_Regularity}" FontSize="10" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding HeatmapConsistencyText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0 2 0 0" />
                                    </StackPanel>
                                </Border>

                                <!-- Метрика 3: В активный день -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="12 8" Margin="0 6 6 0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dash_InActiveDay}" FontSize="10" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding HeatmapAvgDayText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 2 0 0" />
                                    </StackPanel>
                                </Border>

                                <!-- Метрика 4: Рекордный день -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="12 8" Margin="6 6 0 0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dash_BestDay}" FontSize="10" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding HeatmapBestDayText}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" Margin="0 2 0 0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Анализ режима дня и сна -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="20 16" Margin="0 0 0 20">
                <StackPanel>
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dash_RhythmTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Dash_RhythmSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="6 2 0 0" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource ControlBgBrush}" CornerRadius="6" Padding="10 4">
                            <TextBlock Text="{Binding RhythmNoteText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0 4 0 0">
                        <!-- Включение / Подъём -->
                        <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="16 12" Margin="0 0 8 0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dash_RhythmWakeUp}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 4" />
                                <TextBlock Text="{Binding RhythmWakeUpText}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                <TextBlock Text="{DynamicResource Dash_MonthlyAvg}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                            </StackPanel>
                        </Border>

                        <!-- Выключение / Отбой -->
                        <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="16 12" Margin="4 0 4 0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dash_RhythmSleep}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 4" />
                                <TextBlock Text="{Binding RhythmSleepText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Dash_MonthlyAvg}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                            </StackPanel>
                        </Border>

                        <!-- Ночной перерыв -->
                        <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="16 12" Margin="8 0 0 0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dash_RhythmBreak}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 4" />
                                <TextBlock Text="{Binding RhythmRestDurationText}" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock Text="{DynamicResource Dash_PcOffInterval}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="20 16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_AppsSection}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 14" />

                    <ItemsControl ItemsSource="{Binding TopApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Icon}" Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4 0" />

                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="4 0" />

                                    <ProgressBar Grid.Column="3"
                                                 Value="{Binding Percentage}"
                                                 Maximum="100"
                                                 Height="6"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource ControlBgBrush}"
                                                 Margin="10 0 0 0"
                                                 VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Dash_NoAppsData}"
                               Foreground="#6B7280" FontSize="13" TextWrapping="Wrap"
                               Margin="0 8 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

