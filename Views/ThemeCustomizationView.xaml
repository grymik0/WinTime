<UserControl x:Class="WinTime.Views.ThemeCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WinTime.Services"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0 22 0 10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36 28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0 0 0 24">
                <TextBlock Text="Оформление и темы" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 4" />
                <TextBlock Text="Настройте внешний вид WinTime: выбор темы оформления, акцентных цветов и стилей"
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" MaxWidth="500" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="РЕЖИМ ОФОРМЛЕНИЯ" Style="{StaticResource SectionTitle}" Margin="0 0 0 12" />

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14 12" Margin="0 0 0 8"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🌙" FontSize="22" VerticalAlignment="Center" Margin="0 0 14 0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 12 0">
                                <TextBlock Text="Тёмная (Dark)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Классическая тёмная палитра для комфортной работы"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0 2 0 0" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Выбрать"
                                    Command="{Binding SelectThemeCommand}"
                                    CommandParameter="{x:Static services:AppThemeMode.Dark}"
                                    Padding="14 7" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14 12" Margin="0 0 0 8"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="☀️" FontSize="22" VerticalAlignment="Center" Margin="0 0 14 0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 12 0">
                                <TextBlock Text="Светлая (Light)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Чистый дизайн для дневного света и светлых интерьеров"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0 2 0 0" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Выбрать"
                                    Command="{Binding SelectThemeCommand}"
                                    CommandParameter="{x:Static services:AppThemeMode.Light}"
                                    Padding="14 7" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14 12" Margin="0 0 0 16"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🌌" FontSize="22" VerticalAlignment="Center" Margin="0 0 14 0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 12 0">
                                <TextBlock Text="Полночь (Midnight)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Глубокий контрастный чёрный цвет для OLED экранов"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0 2 0 0" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Выбрать"
                                    Command="{Binding SelectThemeCommand}"
                                    CommandParameter="{x:Static services:AppThemeMode.Midnight}"
                                    Padding="12 6" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMidnightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="ОСНОВНОЙ ЦВЕТ АКЦЕНТА" Style="{StaticResource SectionTitle}" Margin="0 10 0 12" />

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16 16"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Выберите цвет кнопок, графиков и ключевых индикаторов:"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 14" />

                            <ItemsControl ItemsSource="{Binding Accents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Option}"
                                                Margin="0 0 12 12" Cursor="Hand" ToolTip="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="42" Height="42" CornerRadius="21"
                                                            Background="{Binding ColorBrush}"
                                                            BorderBrush="{DynamicResource TextPrimaryBrush}"
                                                            BorderThickness="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                                        </Border.Effect>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Правая колонка: Интерактивный Live Preview -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ИНТЕРАКТИВНЫЙ ПРЕДПРОСМОТР (LIVE PREVIEW)" Style="{StaticResource SectionTitle}" Margin="0 0 0 12" />

                    <!-- Рамка предпросмотра стилизованного окна WinTime -->
                    <Border Background="{DynamicResource AppBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>

                            <!-- Хедер мини-окна -->
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0 0 8 0" />
                                    <TextBlock Text="Пример карточки активности" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8 3">
                                    <TextBlock Text="🔥 Активен" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </Grid>

                            <!-- Карточка метрик -->
                            <Border Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0 0 0 14">
                                <StackPanel>
                                    <TextBlock Text="Общее время за сегодня" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="6ч 42м" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0 4 0 2" />
                                    <TextBlock Text="▲ на 24% больше, чем вчера" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Вторичная карточка и список приложений -->
                            <Border Background="{DynamicResource CardSubBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Margin="0 0 0 8">
                                        <TextBlock Text="Top Application: Visual Studio" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="78%" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>

                                    <!-- Прогресс-бар цвета акцента -->
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource ControlBgBrush}">
                                        <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left" Width="180" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Кнопки действий -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Кнопка с акцентом" Padding="12 9" FontSize="12" FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Content="Вторичная кнопка" Padding="12 9" FontSize="12" FontWeight="Medium"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

