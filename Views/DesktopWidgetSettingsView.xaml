<UserControl x:Class="WinTime.Views.DesktopWidgetSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin"     Value="0 20 0 10" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="16 9" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeSelectBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="Padding"         Value="12 7" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36 28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0 0 0 24">
                <TextBlock Text="{DynamicResource Widget_Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 4" />
                <TextBlock Text="{DynamicResource Widget_Subtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- Main content: 2 columns (Settings on left, Live preview on right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340" MaxWidth="460" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left column: Options -->
                <StackPanel Grid.Column="0">

                    <!-- Widget status and main controls -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <Grid Margin="0 0 0 12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Widget_StateSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Widget_ScreenDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="6" Padding="10 4">
                                    <TextBlock FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Widget_StatusOff}" />
                                                <Setter Property="Foreground" Value="#EF4444" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWidgetEnabled}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource Widget_StatusOn}" />
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <WrapPanel Margin="0 4 0 0">
                                <Button Command="{Binding ToggleWidgetCommand}"
                                        Margin="0 0 8 8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWidgetEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding WidgetToggleLabel}" />
                                </Button>

                                <Button Content="{DynamicResource Widget_ResetPos}"
                                        Command="{Binding ResetPositionCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0 0 0 8"
                                        ToolTip="{DynamicResource Widget_ResetPosTip}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Display mode section -->
                    <TextBlock Text="{DynamicResource Widget_ModeSection}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <!-- Standard mode button -->
                                <Button Content="{DynamicResource Widget_ModeStandard}"
                                        Command="{Binding SetDisplayModeCommand}"
                                        Margin="0 0 4 0">
                                    <Button.CommandParameter>
                                        <sys:Int32>0</sys:Int32>
                                    </Button.CommandParameter>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModeSelectBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStandardMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Compact mode button -->
                                <Button Content="{DynamicResource Widget_ModeCompact}"
                                        Command="{Binding SetDisplayModeCommand}"
                                        Margin="2 0 2 0">
                                    <Button.CommandParameter>
                                        <sys:Int32>1</sys:Int32>
                                    </Button.CommandParameter>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModeSelectBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Micro mode button -->
                                <Button Content="{DynamicResource Widget_ModeMicro}"
                                        Command="{Binding SetDisplayModeCommand}"
                                        Margin="4 0 0 0">
                                    <Button.CommandParameter>
                                        <sys:Int32>2</sys:Int32>
                                    </Button.CommandParameter>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModeSelectBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicroMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Behavior & interaction -->
                    <TextBlock Text="{DynamicResource Widget_SectionBehavior}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <!-- Click-through -->
                            <CheckBox IsChecked="{Binding IsClickThrough}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ClickThrough}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ClickThroughDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Always on Top -->
                            <CheckBox IsChecked="{Binding IsTopmost}" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_Topmost}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_TopmostDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Display modules -->
                    <TextBlock Text="{DynamicResource Widget_SectionBlocks}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <!-- Active app -->
                            <CheckBox IsChecked="{Binding ShowApp}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowApp}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowAppDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- App limit timer -->
                            <CheckBox IsChecked="{Binding ShowLimit}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowLimit}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowLimitDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Screen time today -->
                            <CheckBox IsChecked="{Binding ShowTime}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowTime}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowTimeDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Session timer -->
                            <CheckBox IsChecked="{Binding ShowSession}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowSession}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowSessionDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Streak 🔥 -->
                            <CheckBox IsChecked="{Binding ShowStreak}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowStreak}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowStreakDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Profile level & XP -->
                            <CheckBox IsChecked="{Binding ShowLevel}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowLevel}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowLevelDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Mouse activity -->
                            <CheckBox IsChecked="{Binding ShowMouse}" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowMouse}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowMouseDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Appearance & opacity -->
                    <TextBlock Text="{DynamicResource Widget_SectionAppearance}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16">
                        <StackPanel>
                            <Grid Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Widget_Opacity}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding WidgetOpacityPercentText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Slider Minimum="0.3" Maximum="1.0"
                                     Value="{Binding WidgetOpacity}"
                                     TickFrequency="0.05" IsSnapToTickEnabled="True"
                                     Foreground="{DynamicResource AccentBrush}" Margin="0 6 0 0" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right column: Interactive Live Preview -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource Widget_PreviewSection}" Style="{StaticResource SettingSectionTitle}" Margin="0 0 0 10" />

                    <!-- Desktop simulation frame -->
                    <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel HorizontalAlignment="Center">

                            <!-- Widget mockup container -->
                            <Border Width="{Binding WidgetContainerWidth}"
                                    Background="#EE181825"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    Opacity="{Binding WidgetOpacity}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14" />
                                        <Setter Property="Padding" Value="14 12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMicroMode}" Value="True">
                                                <Setter Property="CornerRadius" Value="16" />
                                                <Setter Property="Padding" Value="10 6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
                                </Border.Effect>

                                <StackPanel>
                                    <!-- 1. Micro Mode in Preview -->
                                    <Grid Visibility="{Binding IsMicroMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                                                    Background="#331E12" CornerRadius="6" Padding="5 2" Margin="0 0 6 0">
                                                <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding DoesNotHaveAppLimit, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⏱" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBlock Text="{Binding TodayTimeText}" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⏳" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBlock Text="{Binding LimitRemainingText}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding LimitBadgeColor}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="⤢" FontSize="10" Foreground="#9CA3AF" Margin="4 0 0 0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 2. Compact Mode in Preview -->
                                    <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                                        <TextBlock Grid.Column="1" Text="{Binding TodayTimeText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />

                                        <Border Grid.Column="2" Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                                                Background="#331E12" CornerRadius="6" Padding="6 2" Margin="3 0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                                        </Border>

                                        <Border Grid.Column="3" Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}"
                                                Background="#252535" CornerRadius="6" Padding="6 2" Margin="2 0 4 0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LimitRemainingText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding LimitBadgeColor}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="▾" FontSize="13" Foreground="#9CA3AF" Margin="2 0" VerticalAlignment="Center" />
                                            <TextBlock Text="✕" FontSize="11" Foreground="#6B7280" Margin="2 0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Standard Mode in Preview -->
                                    <StackPanel Visibility="{Binding IsStandardMode, Converter={StaticResource BoolToVis}}">
                                        <!-- Header -->
                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                                                <TextBlock Text="WinTime" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                <Border Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}"
                                                        Background="#331E12" CornerRadius="6" Padding="6 2" Margin="6 0 0 0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StreakBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="▴" FontSize="12" Foreground="#9CA3AF" Margin="0 0 6 0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="✕" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Block 1: Active application -->
                                        <StackPanel Visibility="{Binding ShowApp, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_InFocus}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding CurrentAppName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0 1 0 0" />

                                            <Border Visibility="{Binding HasAppLimit, Converter={StaticResource BoolToVis}}"
                                                    Background="#252535" CornerRadius="6" Padding="8 5" Margin="0 4 0 0">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="⏳ Limit" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LimitStatusText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding LimitBadgeColor}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ProgressBar Height="3" Value="{Binding LimitProgress, Mode=OneWay}" Maximum="100"
                                                                 Background="#181825" Foreground="{Binding LimitBadgeColor}" BorderThickness="0" Margin="0 4 0 0">
                                                        <ProgressBar.Clip>
                                                            <RectangleGeometry Rect="0,0,1000,3" RadiusX="1.5" RadiusY="1.5" />
                                                        </ProgressBar.Clip>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Block 2: Screen time today -->
                                        <StackPanel Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_TodayPc}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding TodayTimeText}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0 1 0 0" />
                                        </StackPanel>

                                        <!-- Block 3: Current session -->
                                        <StackPanel Visibility="{Binding ShowSession, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_CurSession}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding SessionTimeText}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0 1 0 0" />
                                        </StackPanel>

                                        <!-- Block 4: Level & XP -->
                                        <StackPanel Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <Grid Margin="0 0 0 2">
                                                <TextBlock Text="{Binding UserLevelText}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="{Binding XpProgressText}" FontSize="9" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Height="4" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100"
                                                         Background="#252535" Foreground="#F59E0B" BorderThickness="0">
                                                <ProgressBar.Clip>
                                                    <RectangleGeometry Rect="0,0,1000,4" RadiusX="2" RadiusY="2" />
                                                </ProgressBar.Clip>
                                            </ProgressBar>
                                        </StackPanel>

                                        <!-- Block 5: Mouse -->
                                        <StackPanel Visibility="{Binding ShowMouse, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource Dash_MouseActivity}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding MouseSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0 1 0 0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Widget_MicroHint}"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0 16 0 0" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
