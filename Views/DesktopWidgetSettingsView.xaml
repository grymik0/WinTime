<UserControl x:Class="WinTime.Views.DesktopWidgetSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin"     Value="0 20 0 10" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="16 9" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36 28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0 0 0 24">
                <TextBlock Text="{DynamicResource Widget_Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 4" />
                <TextBlock Text="{DynamicResource Widget_Subtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- Основной контент: 2 колонки (Слева настройки, справа интерактивный предпросмотр) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340" MaxWidth="460" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Опции и переключатели -->
                <StackPanel Grid.Column="0">

                    <!-- Статус и главные кнопки управления -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <Grid Margin="0 0 0 12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Widget_StateSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Widget_ScreenDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="6" Padding="10 4">
                                    <TextBlock FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Widget_StatusOff}" />
                                                <Setter Property="Foreground" Value="#EF4444" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWidgetEnabled}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource Widget_StatusOn}" />
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <WrapPanel Margin="0 4 0 0">
                                <Button Command="{Binding ToggleWidgetCommand}"
                                        Margin="0 0 8 8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWidgetEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding WidgetToggleLabel}" />
                                </Button>

                                <Button Command="{Binding ToggleCompactCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0 0 8 8">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Widget_CompactBtn}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource Widget_ExpandedBtn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <Button Content="{DynamicResource Widget_ResetPos}"
                                        Command="{Binding ResetPositionCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0 0 0 8"
                                        ToolTip="{DynamicResource Widget_ResetPosTip}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Поведение и взаимодействие (Сквозные клики и слой) -->
                    <TextBlock Text="{DynamicResource Widget_SectionBehavior}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <!-- Сквозные клики (Click-through) -->
                            <CheckBox IsChecked="{Binding IsClickThrough}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ClickThrough}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ClickThroughDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Слой (Поверх всех окон) -->
                            <CheckBox IsChecked="{Binding IsTopmost}" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_Topmost}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_TopmostDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Выбор информационных блоков -->
                    <TextBlock Text="{DynamicResource Widget_SectionBlocks}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16" Margin="0 0 0 16">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ShowApp}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowApp}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowAppDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <CheckBox IsChecked="{Binding ShowTime}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowTime}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowTimeDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <!-- Новое: Таймер непрерывной сессии -->
                            <CheckBox IsChecked="{Binding ShowSession}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowSession}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowSessionDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <CheckBox IsChecked="{Binding ShowLevel}" Margin="0 0 0 14" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowLevel}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowLevelDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0 0 0 14" />

                            <CheckBox IsChecked="{Binding ShowMouse}" Cursor="Hand">
                                <StackPanel Margin="6 0 0 0">
                                    <TextBlock Text="{DynamicResource Widget_ShowMouse}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{DynamicResource Widget_ShowMouseDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Настройки внешнего вида -->
                    <TextBlock Text="{DynamicResource Widget_SectionAppearance}" Style="{StaticResource SettingSectionTitle}" />

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="18 16">
                        <StackPanel>
                            <Grid Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Widget_Opacity}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding WidgetOpacityPercentText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Slider Minimum="0.3" Maximum="1.0"
                                     Value="{Binding WidgetOpacity}"
                                     TickFrequency="0.05" IsSnapToTickEnabled="True"
                                     Foreground="{DynamicResource AccentBrush}" Margin="0 6 0 0" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Правая колонка: Интерактивный Live Preview виджета -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource Widget_PreviewSection}" Style="{StaticResource SettingSectionTitle}" Margin="0 0 0 10" />

                    <!-- Стилизованная область рабочего стола с макетом -->
                    <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel HorizontalAlignment="Center">

                            <!-- Сам макет виджета в реальном размере -->
                            <Border Width="220"
                                    Background="#EE181825"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14 12"
                                    Opacity="{Binding WidgetOpacity}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
                                </Border.Effect>

                                <StackPanel>
                                    <!-- 1. Компактный режим в предпросмотре -->
                                    <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                                        <TextBlock Grid.Column="1" Text="{Binding TodayTimeText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="▾" FontSize="13" Foreground="#9CA3AF" Margin="4 0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="✕" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 2. Развёрнутый режим в предпросмотре -->
                                    <StackPanel Visibility="{Binding IsNotCompactMode, Converter={StaticResource BoolToVis}}">
                                        <!-- Шапка -->
                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏱" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0" />
                                                <TextBlock Text="WinTime" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="▴" FontSize="12" Foreground="#9CA3AF" Margin="0 0 6 0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="✕" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Блок 1: Активное приложение -->
                                        <StackPanel Visibility="{Binding ShowApp, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_InFocus}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding CurrentAppName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0 1 0 0" />
                                        </StackPanel>

                                        <!-- Блок 2: Время за сегодня -->
                                        <StackPanel Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_TodayPc}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding TodayTimeText}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0 1 0 0" />
                                        </StackPanel>

                                        <!-- Блок 3: Текущая сессия -->
                                        <StackPanel Visibility="{Binding ShowSession, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <TextBlock Text="{DynamicResource Widget_CurSession}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding SessionTimeText}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0 1 0 0" />
                                        </StackPanel>

                                        <!-- Блок 4: Уровень и XP -->
                                        <StackPanel Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVis}}" Margin="0 0 0 6">
                                            <Grid Margin="0 0 0 2">
                                                <TextBlock Text="{Binding UserLevelText}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="{Binding XpProgressText}" FontSize="9" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Height="4" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100"
                                                         Background="#252535" Foreground="#F59E0B" BorderThickness="0">
                                                <ProgressBar.Clip>
                                                    <RectangleGeometry Rect="0,0,1000,4" RadiusX="2" RadiusY="2" />
                                                </ProgressBar.Clip>
                                            </ProgressBar>
                                        </StackPanel>

                                        <!-- Блок 5: Мышь -->
                                        <StackPanel Visibility="{Binding ShowMouse, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource Dash_MouseActivity}" FontSize="9" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding MouseSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0 1 0 0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💡 Зажмите левую кнопку мыши на виджете, чтобы перетащить его в удобное место экрана."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0 16 0 0" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>

