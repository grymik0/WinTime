<UserControl x:Class="WinTime.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin"       Value="0 24 0 10" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"     Value="0 0 0 4" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin"     Value="0 0 0 16" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="18 10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin"          Value="0 0 0 8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36 24" MaxWidth="640">

            <TextBlock Text="{DynamicResource Settings_Title}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 4" />
            <TextBlock Text="{DynamicResource Settings_Subtitle}"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />

            <TextBlock Text="{DynamicResource Settings_SectionTracking}" Style="{StaticResource SectionHeader}" />

            <!-- AFK Slider -->
            <TextBlock Text="{DynamicResource Settings_AfkThreshold}" Style="{StaticResource SettingLabel}" />
            <Grid Margin="0 0 0 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="1" Maximum="10"
                        Value="{Binding AfkThresholdMinutes}"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="12 0 0 0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <Run Text="{Binding AfkThresholdMinutes}" /><Run Text=" " /><Run Text="{DynamicResource Settings_AfkUnit}" />
                </TextBlock>
            </Grid>
            <TextBlock Style="{StaticResource SettingHint}"
                       Text="{DynamicResource Settings_AfkHint}" />

            <TextBlock Text="{DynamicResource Settings_SectionSystem}" Style="{StaticResource SectionHeader}" />

            <CheckBox IsChecked="{Binding LaunchOnStartup}"
                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                      Content="{DynamicResource Settings_LaunchStartup}"
                      Margin="0 0 0 20"
                      Cursor="Hand" />

            <TextBlock Text="{DynamicResource Settings_SectionDb}" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="{DynamicResource Settings_DbPath}" Style="{StaticResource SettingLabel}" />
            <Grid Margin="0 0 0 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding DatabasePath, Mode=OneWay}"
                         IsReadOnly="True"
                         Padding="10 7"
                         FontSize="13" FontFamily="Consolas"
                         Background="{DynamicResource CardBgBrush}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         BorderBrush="{DynamicResource BorderBrushColor}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center" />

                <Button Grid.Column="2"
                        Content="{DynamicResource Settings_DbBrowse}"
                        Command="{Binding ChooseDbPathCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="0" />
            </Grid>

            <TextBlock Text="{Binding DbChangeNote}"
                       FontSize="12" Foreground="#F59E0B"
                       Margin="0 0 0 20"
                       TextWrapping="Wrap" />

            <TextBlock Text="{DynamicResource Settings_SectionExport}" Style="{StaticResource SectionHeader}" />

            <WrapPanel Margin="0 0 0 8">
                <Button Content="{DynamicResource Settings_ExportCsv}"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="0 0 8 8" />
                <Button Content="{DynamicResource Settings_ExportJson}"
                        Command="{Binding ExportJsonCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="0 0 0 8" />
            </WrapPanel>

            <TextBlock Text="{DynamicResource Settings_SectionDanger}" Style="{StaticResource SectionHeader}" />

            <Button Content="{DynamicResource Settings_ClearHistory}"
                    Command="{Binding ClearHistoryCommand}"
                    Background="#3B1B1B"
                    Foreground="#F87171"
                    BorderThickness="0"
                    Padding="18 10"
                    FontSize="13"
                    Cursor="Hand"
                    HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Style="{StaticResource SettingHint}"
                       Margin="0 6 0 0"
                       Text="{DynamicResource Settings_ClearHint}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>

