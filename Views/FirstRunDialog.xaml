<Window x:Class="WinTime.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в WinTime"
        Width="540" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C1C28"
        Foreground="White">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="⏱  WinTime" FontSize="26" FontWeight="Bold" Foreground="#6366F1" />
            <TextBlock Text="Учёт экранного времени" FontSize="13" Foreground="#9CA3AF" Margin="0 4 0 0" />
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="2"
                   Text="Выберите файл, в котором WinTime будет хранить базу данных.&#10;Если файл не существует — он будет создан автоматически."
                   FontSize="13" Foreground="#D1D5DB"
                   TextWrapping="Wrap" LineHeight="22" />

        <!-- Path input -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtPath"
                     Grid.Column="0"
                     IsReadOnly="True"
                     Padding="10 6"
                     FontSize="13"
                     Background="#252535"
                     Foreground="White"
                     BorderBrush="#374151"
                     VerticalContentAlignment="Center"
                     Text="Путь не выбран…" />

            <Button Grid.Column="2"
                    Content="Обзор…"
                    Click="BtnBrowse_Click"
                    Padding="16 6"
                    FontSize="13"
                    Background="#374151"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
        </Grid>

        <!-- Start button -->
        <Button Grid.Row="6"
                Content="Начать отслеживание  →"
                Click="BtnStart_Click"
                HorizontalAlignment="Right"
                Padding="20 10"
                FontSize="14" FontWeight="SemiBold"
                Background="#6366F1"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                IsDefault="True" />
    </Grid>
</Window>
