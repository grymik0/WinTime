<UserControl x:Class="WinTime.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinTime.ViewModels"
             Background="{DynamicResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28 24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Profile_Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Profile_Subtitle}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource Common_Refresh}"
                        Command="{Binding RefreshCommand}"
                        Padding="14 7"
                        FontSize="13"
                        Background="{DynamicResource ControlBgBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand" />
            </Grid>

            <!-- Карточка Уровня и Опыта -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="24 20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Аватарка / Значок уровня -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserLevel, StringFormat={}Lvl {0}}"
                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12 0 0 0">
                            <TextBlock Text="{Binding RankTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Profile_XpHint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0" />
                        </StackPanel>

                        <!-- Статистические мини-бейджы справа -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="14 8" Margin="0 0 10 0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Profile_AllTime}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="14 8" Margin="0 0 10 0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Profile_ActiveDays}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveDaysFormatted}" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardSubBgBrush}" CornerRadius="8" Padding="14 8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Profile_Achievements}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding UnlockedAchievementsCountText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Прогресс-бар опыта (XP) -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0 0 0 8">
                            <TextBlock Text="{DynamicResource Profile_Progress}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding LevelProgressText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Height="10" Value="{Binding LevelProgress, Mode=OneWay}" Maximum="100"
                                     Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0">
                            <ProgressBar.Clip>
                                <RectangleGeometry Rect="0,0,10000,10" RadiusX="5" RadiusY="5" />
                            </ProgressBar.Clip>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Секция достижений -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="{DynamicResource Profile_AllAchList}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 14" />

                <ItemsControl ItemsSource="{Binding Achievements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16 14"
                                    Margin="0 0 12 12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка достижения -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource ControlBgBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Название и описание -->
                                    <StackPanel Grid.Column="1" Margin="8 0 12 0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0 3 0 6" TextWrapping="Wrap" />

                                        <!-- Прогресс достижения -->
                                        <Grid Margin="0 2 0 0">
                                            <ProgressBar Height="5" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                         Background="{DynamicResource ControlBgBrush}" Foreground="#10B981" BorderThickness="0" />
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
                                    </StackPanel>

                                    <!-- Бейдж статуса -->
                                    <Border Grid.Column="2" CornerRadius="6"
                                            Padding="8 4" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                        <Setter Property="Background" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

