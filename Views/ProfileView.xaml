<UserControl x:Class="WinTime.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinTime.ViewModels"
             Background="#16161E">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28 24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Профиль и Достижения" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ваш прогресс активности, уровни опыта и разблокированные награды"
                               FontSize="12" Foreground="#9CA3AF" Margin="0 4 0 0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🔄  Обновить"
                        Command="{Binding RefreshCommand}"
                        Padding="14 7"
                        FontSize="13"
                        Background="#252535"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        Cursor="Hand" />
            </Grid>

            <!-- Карточка Уровня и Опыта -->
            <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="12" Padding="24 20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Аватарка / Значок уровня -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#312E81"
                                BorderBrush="#6366F1" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserLevel, StringFormat={}Ур.{0}}"
                                       FontSize="14" FontWeight="Bold" Foreground="#C7D2FE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12 0 0 0">
                            <TextBlock Text="{Binding RankTitle}" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Зарабатывайте XP, проводя время за полезной работой" FontSize="12" Foreground="#9CA3AF" Margin="0 2 0 0" />
                        </StackPanel>

                        <!-- Статистические мини-бейджы справа -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#252535" CornerRadius="8" Padding="14 8" Margin="0 0 10 0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Время за всё время" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="#252535" CornerRadius="8" Padding="14 8" Margin="0 0 10 0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Активных дней" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveDaysFormatted}" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="#252535" CornerRadius="8" Padding="14 8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Достижения" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding UnlockedAchievementsCountText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0 2 0 0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Прогресс-бар опыта (XP) -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0 0 0 8">
                            <TextBlock Text="Прогресс уровня" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" />
                            <TextBlock Text="{Binding LevelProgressText}" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Height="10" Value="{Binding LevelProgress, Mode=OneWay}" Maximum="100"
                                     Background="#16161E" Foreground="#6366F1" BorderThickness="0">
                            <ProgressBar.Clip>
                                <RectangleGeometry Rect="0,0,10000,10" RadiusX="5" RadiusY="5" />
                            </ProgressBar.Clip>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Секция достижений -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="🏆  Все достижения" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0 0 0 14" />

                <ItemsControl ItemsSource="{Binding Achievements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16 14"
                                    Margin="0 0 12 12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка достижения -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#252535"
                                            Opacity="{Binding IconOpacity}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Название и описание -->
                                    <StackPanel Grid.Column="1" Margin="8 0 12 0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{Binding TitleForeground}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9CA3AF"
                                                   Margin="0 3 0 6" TextWrapping="Wrap" />

                                        <!-- Прогресс достижения -->
                                        <Grid Margin="0 2 0 0">
                                            <ProgressBar Height="5" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                         Background="#16161E" Foreground="#10B981" BorderThickness="0" />
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="#6B7280" Margin="0 4 0 0" />
                                    </StackPanel>

                                    <!-- Бейдж статуса -->
                                    <Border Grid.Column="2" Background="{Binding StatusBadgeBg}" CornerRadius="6"
                                            Padding="8 4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBadgeFg}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
