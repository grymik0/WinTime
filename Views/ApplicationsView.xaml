<UserControl x:Class="WinTime.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinTime.ViewModels"
             Background="#16161E">

    <Grid Margin="24 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Приложения"
                   FontSize="22" FontWeight="Bold" Foreground="White" />

        <!-- Поиск -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10 7"
                     FontSize="13"
                     Background="#1E1E2E"
                     Foreground="White"
                     BorderBrush="#374151"
                     BorderThickness="1"
                     VerticalContentAlignment="Center" />

            <Button Grid.Column="2"
                    Content="🔄  Обновить"
                    Command="{Binding RefreshCommand}"
                    Padding="14 7"
                    FontSize="13"
                    Background="#252535"
                    Foreground="#9CA3AF"
                    BorderThickness="0"
                    Cursor="Hand" />
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="4"
                  x:Name="AppsGrid"
                  ItemsSource="{Binding Apps}"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="False"
                  CanUserAddRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#252535"
                  Background="#1E1E2E"
                  RowBackground="#1E1E2E"
                  AlternatingRowBackground="#212133"
                  Foreground="White"
                  BorderBrush="#374151"
                  BorderThickness="1"
                  ColumnHeaderHeight="36"
                  RowHeight="38"
                  RowHeaderWidth="0"
                  RowEditEnding="AppsGrid_RowEditEnding">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"   Value="#252535" />
                    <Setter Property="Foreground"   Value="#9CA3AF" />
                    <Setter Property="FontSize"     Value="12" />
                    <Setter Property="Padding"      Value="12 0" />
                    <Setter Property="BorderThickness" Value="0 0 0 1" />
                    <Setter Property="BorderBrush"  Value="#374151" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding"      Value="10 0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2D2D44" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Отображаемое имя (редактируемое) -->
                <DataGridTextColumn Header="Приложение"
                                    Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                    Width="200"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}" />

                <!-- Имя процесса (только чтение) -->
                <DataGridTextColumn Header="Процесс"
                                    Binding="{Binding ProcessName}"
                                    IsReadOnly="True"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6B7280" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize"   Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Категория -->
                <DataGridTemplateColumn Header="Категория" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category}"
                                       Foreground="#9CA3AF" FontSize="13"
                                       VerticalAlignment="Center" Padding="10 0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static vm:ApplicationsViewModel.Categories}"
                                      SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                      Background="#252535"
                                      Foreground="White"
                                      BorderThickness="0"
                                      FontSize="13" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Не отслеживать (blacklist) -->
                <DataGridTemplateColumn Header="Не отслеживать" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsBlacklisted, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
