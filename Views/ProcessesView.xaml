<UserControl x:Class="WinTime.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:WinTime.Core"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Background"         Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"         Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness"    Value="0" />
            <Setter Property="Padding"            Value="18 7" />
            <Setter Property="FontSize"           Value="13" />
            <Setter Property="Cursor"             Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"             Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground"             Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize"               Value="12" />
            <Setter Property="Padding"                Value="12 0" />
            <Setter Property="Height"                 Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness"        Value="0 0 0 1" />
            <Setter Property="BorderBrush"            Value="{DynamicResource BorderBrushColor}" />
        </Style>

        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness"   Value="0" />
            <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
            <Setter Property="Background"        Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="12 0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background"     Value="{DynamicResource CardBgBrush}" />
            <Setter Property="MinHeight"      Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="DetailsVisibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource CardSubBgBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Proc_Title}"
                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource Proc_Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Common_Today}" Margin="0 0 8 0"
                        Command="{Binding SetTodayCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodToday}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{DynamicResource Common_Week}" Margin="0 0 8 0"
                        Command="{Binding SetWeekCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodWeek}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{DynamicResource Common_Month}"
                        Command="{Binding SetMonthCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeriodMonth}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10 7"
                     FontSize="13"
                     Background="{DynamicResource CardBgBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrushColor}"
                     BorderThickness="1"
                     VerticalContentAlignment="Center" />

            <!-- Переключатель режима (Все / Только игры) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14 0 0 0">
                <Button Content="{DynamicResource Proc_AllProcesses}"
                        Command="{Binding ShowAllProcessesCommand}"
                        Background="{Binding FilterAllBackground}"
                        Foreground="{Binding FilterAllForeground}"
                        Style="{StaticResource PeriodBtn}"
                        Margin="0 0 6 0" />

                <Button Content="{DynamicResource Proc_GameMode}"
                        Command="{Binding ShowOnlyGamesCommand}"
                        Background="{Binding FilterGamesBackground}"
                        Foreground="{Binding FilterGamesForeground}"
                        Style="{StaticResource PeriodBtn}" />
            </StackPanel>

            <Button Grid.Column="3"
                    Content="{DynamicResource Common_Refresh}"
                    Command="{Binding RefreshCommand}"
                    Padding="14 7"
                    FontSize="13"
                    Background="{DynamicResource ControlBgBrush}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderThickness="0"
                    Cursor="Hand" />
        </Grid>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="False"
                  CanUserAddRows="False"
                  CanUserReorderColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternationCount="2"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                  Background="{DynamicResource CardBgBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrushColor}"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  LoadingRow="AppsGrid_LoadingRow"
                  ColumnHeaderStyle="{StaticResource ColHeader}"
                  CellStyle="{StaticResource CellStyle}"
                  RowStyle="{StaticResource RowStyle}">

            <DataGrid.Columns>

                <!-- Раскрытие заголовков/вкладок -->
                <DataGridTemplateColumn Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="ToggleExpand_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="26" Height="26"
                                    ToolTip="{DynamicResource Proc_ExpandTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▼" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColStatus}" Width="110" SortMemberPath="IsCurrentlyRunning">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0 0 6 0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#6B7280" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Proc_StatusClosed}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyRunning}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Proc_StatusRunning}" />
                                                    <Setter Property="Foreground" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColApp}" Width="200" SortMemberPath="FriendlyName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FriendlyName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColProcess}" Width="160" SortMemberPath="ProcessName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProcessName}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColUptime}" Width="140" SortMemberPath="UptimeSeconds">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FormattedUptime}"
                                       Foreground="#38BDF8"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColActive}" Width="130" SortMemberPath="ActiveSeconds">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FormattedActiveTime}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource Proc_ColRatio}" Width="140" SortMemberPath="ActiveRatioPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FormattedRatio}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <ProgressBar Grid.Column="1"
                                             Height="6"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ActiveRatioPercent, Mode=OneWay}"
                                             Background="{DynamicResource ControlBgBrush}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0 1 0 1" Padding="46 12 24 14">
                        <StackPanel>
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Proc_RowDetailsTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{DynamicResource Proc_RowDetailsSub}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="4 1 0 0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Proc_RowDetailsLoading}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding IsLoadingTitles, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Proc_RowDetailsEmpty}"
                                       FontSize="12" Foreground="#6B7280" Margin="0 4"
                                       Visibility="{Binding HasNoTitles, Converter={StaticResource BoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding WindowTitles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       ToolTip="{Binding RawTitle}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0 0 16 0" />

                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}"
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0 0 12 0" />

                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Percentage, StringFormat={}{0:F0}%}"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1"
                                                             Value="{Binding Percentage}"
                                                             Maximum="100" Height="5"
                                                             Background="{DynamicResource ControlBgBrush}"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             BorderThickness="0"
                                                             VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

    </Grid>
</UserControl>
