<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WinTime</AssemblyName>
    <RootNamespace>WinTime</RootNamespace>
    <Platforms>x64</Platforms>
    <!-- Suppress NU1701: transitive deps (OpenTK, SkiaSharp, WPF.UI) work via
         .NETFramework compatibility shim, not a true incompatibility -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modern Fluent Design UI components -->
    <PackageReference Include="Wpf.Ui" Version="3.1.0" />
    <!-- SQLite embedded database -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Lightweight ORM for SQL queries -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Charts (pie, bar) -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- System tray icon -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- CSV export -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>

</Project>

